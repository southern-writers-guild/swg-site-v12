      "permanent": true
    },
    {
      "source": "/the-work/first-light",
      "destination": "/the-work/featured/first-light/",
      "permanent": true
    },
    {
      "source": "/the-work/ugly-duckling/",
      "destination": "/the-work/featured/the-ugly-duckling/",
      "permanent": true
    },
    {
      "source": "/the-work/ugly-duckling",
