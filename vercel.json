    },
    {
      "source": "/events/:slug/",
      "destination": "/events/event/index.html"
    },
    {
      "source": "/contributors/work/:slug",
      "destination": "/contributors/work/piece/index.html"
    },
    {
      "source": "/contributors/work/:slug/",
      "destination": "/contributors/work/piece/index.html"
    },
    {
      "source": "/contributors/:slug",
      "destination": "/contributors/contributor/index.html"
    },
    {
      "source": "/contributors/:slug/",
      "destination": "/contributors/contributor/index.html"
    },
    {
      "source": "/the-work/videos/:slug",
      "destination": "/the-work/videos/video/index.html"
    },
    {
      "source": "/the-work/videos/:slug/",
      "destination": "/the-work/videos/video/index.html"
    },
    {
      "source": "/writers/:slug",
      "destination": "/writers/writer/index.html"
    },
    {
      "source": "/writers/:slug/",
      "destination": "/writers/writer/index.html"
